<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla «Mi Banco». Los componentes replican los del simulador Flutter
    (cabecera con degradado, tarjeta de sección, campos rellenos, chips de
    plazo, botones) con la paleta Pragma, para que las tres apps se vean como
    un mismo producto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include
        android:id="@+id/banner"
        layout="@layout/banner_plataforma" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Cabecera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cabecera"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icono_cabecera"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_banco" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/titulo"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.85"
                    android:text="@string/subtitulo"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tarjeta del formulario -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/superficie"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_icono_seccion"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_ajustes" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/seccion_formulario"
                                android:textColor="@color/texto_principal"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/seccion_subtitulo"
                                android:textColor="@color/texto_secundario"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Monto -->
                    <include
                        android:id="@+id/etiquetaMonto"
                        layout="@layout/fila_etiqueta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contenedorMonto"
                        style="@style/CampoPragma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:helperText="@string/ayuda_monto"
                        app:prefixText="$ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputMonto"
                            style="@style/TextoCampoPragma"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9"
                            android:text="10000000" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View style="@style/DivisorPragma" />

                    <!-- Tasa -->
                    <include
                        android:id="@+id/etiquetaTasa"
                        layout="@layout/fila_etiqueta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contenedorTasa"
                        style="@style/CampoPragma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:helperText="@string/ayuda_tasa"
                        app:suffixText="@string/sufijo_tasa">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputTasa"
                            style="@style/TextoCampoPragma"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="1.5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View style="@style/DivisorPragma" />

                    <!-- Plazo -->
                    <include
                        android:id="@+id/etiquetaPlazo"
                        layout="@layout/fila_etiqueta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/grupoPlazos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <View style="@style/DivisorPragma" />

                    <!-- Moneda: fija en esta demo -->
                    <include
                        android:id="@+id/etiquetaMoneda"
                        layout="@layout/fila_etiqueta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Acciones -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonAbrir"
                style="@style/BotonPrimarioPragma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/boton_abrir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonLimpiar"
                style="@style/BotonSecundarioPragma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/boton_limpiar" />

            <!-- Lo que se enviaría al módulo Flutter -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/primario_profundo"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_payload"
                        android:textColor="@color/acento"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textoPayload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:textColor="@android:color/white"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="@string/nota_sin_conectar"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
