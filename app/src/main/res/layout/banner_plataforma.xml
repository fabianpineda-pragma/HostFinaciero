<?xml version="1.0" encoding="utf-8"?>
<!--
    Banner de plataforma: identifica en la charla qué pantalla es nativa y cuál
    es Flutter. El fondo se extiende por detrás de la barra de estado; el
    padding superior lo pone MainActivity con los insets del sistema.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/banner_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/punto_plataforma" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="@string/banner_plataforma"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/banner_tecnologia"
            android:textColor="@color/banner_secundario"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
